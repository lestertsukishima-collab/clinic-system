APP_NAME="Happy Clinic"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-with-your-domain.invalid

CLINIC_TIMEZONE=Asia/Manila
CLINIC_APPOINTMENT_DURATION_MINUTES=30

# Initial administrator setup. Clear the password after seeding, then rebuild config cache.
CLINIC_ADMIN_NAME=
CLINIC_ADMIN_EMAIL=
CLINIC_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Keep database/database.sqlite on persistent storage outside the public directory.
# For SQLite on a mounted disk, set DB_DATABASE to that file's absolute path.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/private/path/to/clinic.sqlite
# For a host-managed MySQL database, change DB_CONNECTION=mysql and fill these in.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Current notifications are synchronous; no background worker is needed for this setting.
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_TIMEOUT=5
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
